PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=maintiq
# Local MySQL: leave MYSQL_SSL unset (or 0) — no TLS.
# Render + Aiven: set MYSQL_SSL=1 and MYSQL_SSL_CA to the Aiven project CA PEM
# (Overview → Download CA certificate). Keep rejectUnauthorized enabled (default).
# MYSQL_SSL=1
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MYSQL_SSL_CA_PATH=./certs/aiven-ca.pem
# MYSQL_SSL_VERIFY_IDENTITY=1

SESSION_SECRET=change-me-in-production

LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
