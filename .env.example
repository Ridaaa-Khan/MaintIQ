PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=maintiq
# Local MySQL (development): leave MYSQL_SSL unset/0 — connects without TLS.
# Render + Aiven (production): MYSQL_SSL=1 and MYSQL_SSL_CA are required.
# Download CA from Aiven → service Overview → "Download CA certificate".
# Paste the full PEM into MYSQL_SSL_CA (use \n for newlines in a single-line env value).
# MYSQL_SSL=1
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MYSQL_SSL_CA_PATH=./certs/aiven-ca.pem
# MYSQL_SSL_VERIFY_IDENTITY=1

SESSION_SECRET=change-me-in-production

LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
