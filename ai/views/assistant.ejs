<%- include('partials/app-open', { page: 'assistant', title: 'AI Assistant', heading: 'AI Assistant', kicker: 'Explain results', user }) %>

<div class="assistant-workspace" id="assistant-workspace">
  <aside class="assistant-history" aria-label="Chat history">
    <div class="assistant-history-head">
      <h2>History</h2>
      <button class="btn btn-icon" type="button" data-assistant-new aria-label="New chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </div>
    <label class="assistant-search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" id="assistant-search" placeholder="Search chats by title…" aria-label="Search chats by title" />
    </label>
    <div class="assistant-history-scroll">
      <section class="assistant-history-group" id="assistant-pinned-group" hidden>
        <h3>Pinned</h3>
        <div class="assistant-history-list" id="assistant-pinned"></div>
      </section>
      <section class="assistant-history-group">
        <h3>Recents</h3>
        <div class="assistant-history-list" id="assistant-recents"></div>
      </section>
      <p class="muted assistant-history-empty" id="assistant-history-empty" hidden>No chats match that title.</p>
    </div>
  </aside>

  <section class="assistant-chat" aria-label="Active chat">
    <header class="assistant-chat-head">
      <div class="assistant-chat-title-wrap">
        <h2 id="assistant-chat-title">New chat</h2>
        <button class="btn btn-icon" type="button" id="assistant-rename-active" aria-label="Edit chat title" title="Edit title">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </button>
      </div>
      <button class="btn btn-icon" type="button" id="assistant-pin-active" aria-label="Pin chat" title="Pin chat">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17v5M8 3h8l-1 7h3l-6 7-6-7h3L8 3z"/></svg>
      </button>
    </header>

    <div class="assistant-log" id="assistant-log" role="log" aria-live="polite"></div>

    <form class="assistant-composer" id="assistant-form">
      <input class="field" id="assistant-input" type="text" placeholder="Type your prompt here…" autocomplete="off" />
      <button class="btn btn-primary assistant-send" type="submit" aria-label="Send">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      </button>
    </form>
  </section>
</div>

<%- include('partials/app-close') %>
