<%- include('partials/app-open', { page: 'machines', title: machine.name, heading: 'Machine details', kicker: machine.assetId, user }) %>

<div class="page-head">
  <div>
    <h2><%= machine.name %></h2>
    <p><%= machine.type %> · <%= machine.location %></p>
  </div>
  <div class="btn-row">
    <a class="btn" href="/machines">Back to machines</a>
    <% if (machine.series && machine.series.length) { %>
      <a class="btn btn-primary" href="/analytics?machine=<%= encodeURIComponent(machine.id) %>">Open analytics</a>
    <% } %>
  </div>
</div>

<% if (editErrors && editErrors.length) { %>
  <p class="form-error"><%= editErrors.join(" ") %></p>
<% } %>

<section class="metric-grid">
  <article class="card metric-card">
    <div class="label">Health</div>
    <div class="value" style="font-size:1.2rem"><span class="badge badge-<%= machine.healthClass %>"><%= machine.health %></span></div>
  </article>
  <article class="card metric-card">
    <div class="label">Monitoring</div>
    <div class="value" style="font-size:1.2rem"><span class="badge badge-<%= machine.monitoringClass %>"><%= machine.monitoring %></span></div>
  </article>
  <article class="card metric-card">
    <div class="label">Anomaly score</div>
    <div class="value"><%= machine.anomalyScore %></div>
  </article>
  <article class="card metric-card">
    <div class="label">Last data</div>
    <div class="value" style="font-size:1.05rem"><%= machine.lastData %></div>
  </article>
</section>

<section class="grid-2">
  <article class="card">
    <h3 class="card-title">Profile</h3>
    <dl class="detail-list">
      <div><dt>Asset ID</dt><dd><%= machine.assetId %></dd></div>
      <div><dt>Type</dt><dd><%= machine.type %></dd></div>
      <div><dt>Location</dt><dd><%= machine.location %></dd></div>
      <div><dt>Description</dt><dd><%= machine.description %></dd></div>
      <div><dt>Data source</dt><dd><%= machine.dataSource %></dd></div>
    </dl>
  </article>
  <article class="card">
    <h3 class="card-title">Latest signals</h3>
    <dl class="detail-list">
      <div><dt>RMS</dt><dd><%= machine.rms %></dd></div>
      <div><dt>Peak</dt><dd><%= machine.peak %></dd></div>
      <div><dt>Failure probability</dt><dd><%= machine.failProb %></dd></div>
      <div><dt>Open alerts</dt><dd><%= machine.openAlerts %></dd></div>
    </dl>
  </article>
</section>

<article class="card machine-notes" style="margin-top:14px">
  <div class="notes-head">
    <h3 class="card-title">Notes</h3>
    <button class="btn btn-icon" type="button" data-edit-notes aria-label="Edit notes">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/></svg>
    </button>
  </div>
  <p id="machine-notes-text"><%= machine.notes || "No notes yet." %></p>
  <form id="notes-form" action="/machines/<%= machine.id %>/notes" method="post" hidden>
    <%- include('partials/csrf') %>
    <textarea name="notes" maxlength="2000"><%= machine.notes || "" %></textarea>
    <div class="btn-row">
      <button class="btn btn-primary" type="submit">Save notes</button>
      <button class="btn" type="button" data-cancel-notes>Cancel</button>
    </div>
  </form>
</article>

<% if (machine.upload) { %>
  <article class="card" style="margin-top:14px">
    <h3 class="card-title">Uploaded file</h3>
    <dl class="detail-list">
      <div><dt>File</dt><dd><%= machine.upload.name %></dd></div>
      <div><dt>Check</dt><dd><%= machine.upload.status %></dd></div>
      <div><dt>Rows</dt><dd><%= machine.upload.rows == null ? "—" : machine.upload.rows %></dd></div>
      <div><dt>Columns</dt><dd><%= machine.upload.columns == null ? "—" : machine.upload.columns %></dd></div>
      <div><dt>Result</dt><dd><%= machine.upload.message %></dd></div>
    </dl>
  </article>
<% } %>

<%- include('partials/app-close') %>
