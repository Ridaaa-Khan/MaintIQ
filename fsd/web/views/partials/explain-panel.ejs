<section class="explain-panel" id="explain-<%= graphId %>" data-explain-panel="<%= graphId %>" hidden>
  <header class="explain-panel-bar">
    <div>
      <p class="explain-kicker">Graph explanation</p>
      <h4 class="explain-graph-title"><%= graphTitle %></h4>
    </div>
    <button class="btn btn-icon" type="button" data-explain-collapse="<%= graphId %>" aria-label="Collapse explanation">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>
  </header>
  <div class="explain-panel-body" data-explain-body="<%= graphId %>"></div>
</section>
