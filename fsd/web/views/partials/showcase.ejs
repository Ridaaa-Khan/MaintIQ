<section class="snap-section showcase" id="about">
  <div class="marquee" aria-label="Scrolling collection">
    <div class="marquee-fade">
      <div class="marquee-track">
        <% for (let i = 0; i < 2; i++) { %>
        <p class="marquee-copy">
          SEE THE SIGNAL. UNDERSTAND THE RISK. PLAN WITH CLARITY.
        </p>
        <% } %>
      </div>
    </div>
  </div>

  <p class="showcase-sub">
    Four analytical layers, one operating picture — from raw vibration to a
    maintenance decision you can inspect.
  </p>

  <div class="fan" aria-label="Maint-IQ capability cards">
    <article class="fan-card" style="--i: 0">
      <div class="card-media card-media--signal"></div>
      <h3>Signal</h3>
      <p>Bearing vibration, engineered into time and frequency features.</p>
    </article>
    <article class="fan-card" style="--i: 1">
      <div class="card-media card-media--anomaly"></div>
      <h3>Anomaly</h3>
      <p>Isolation Forest flags unusual machine behaviour early.</p>
    </article>
    <article class="fan-card" style="--i: 2">
      <div class="card-media card-media--risk"></div>
      <h3>Risk</h3>
      <p>XGBoost estimates conditions associated with failure.</p>
    </article>
    <article class="fan-card" style="--i: 3">
      <div class="card-media card-media--explain"></div>
      <h3>Explain</h3>
      <p>Graph explanations turn model outputs into readable findings.</p>
    </article>
    <article class="fan-card" style="--i: 4">
      <div class="card-media card-media--rul"></div>
      <h3>Horizon</h3>
      <p>RUL models explore how degradation may evolve next.</p>
    </article>
  </div>
</section>
